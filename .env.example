# ══════════════════════════════════════════════════════════════════════════════
#  Ghost Tunnel — Environment Configuration
#  Copy to .env and fill in your values:
#    cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── SSH Root Password ──────────────────────────────────────────────────────────
# REQUIRED: Password for SSH root login.
# CHANGE THIS before deploying — the default is intentionally weak.
ROOT_PASS=ChangeMe123!

# ── ntfy Notification Topic ────────────────────────────────────────────────────
# REQUIRED: Your ntfy.sh topic to receive tunnel-up/reconnect notifications.
# Example: NTFY_TOPIC=my-secret-topic-abc123
NTFY_TOPIC=ghost-mail

# ── Port List ──────────────────────────────────────────────────────────────────
# Comma-separated local ports to expose via bore tunnel.
# The FIRST port in the list is used as the SSH port.
#   Single:   PORTS=22
#   Multiple: PORTS=22,80,443,3000,8080
PORTS=22

# ── Bore Server ────────────────────────────────────────────────────────────────
# Bore server hostname. Default is the public bore.pub server.
# Use your own bore server: BORE_SERVER=your-server.com
BORE_SERVER=bore.pub

# ── Health Check HTTP Port ─────────────────────────────────────────────────────
# Port for the internal /health endpoint.
# Railway / Render set this automatically.
PORT=8080

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Asia/Jakarta

# ── Log Level ─────────────────────────────────────────────────────────────────
# Options: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO
